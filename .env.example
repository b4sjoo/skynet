# Workspace / AI Heartbeat optional configuration.
# Copy to .env and fill only what you need. The default Claude Code backend needs NONE of these.

# --- Heartbeat backend ---
# claude (default): uses the local, already-authenticated `claude` CLI (no key required).
# opencode: uses a running OpenCode Server (periodic_jobs/ai_heartbeat/src/v0/opencode_client.py).
HEARTBEAT_BACKEND=claude
# Per-script model override (aliases: sonnet|opus|haiku, or a full model id)
# HEARTBEAT_OBSERVER_MODEL=sonnet
# HEARTBEAT_REFLECTOR_MODEL=opus
# claude permission mode for unattended runs: acceptEdits (least privilege) or bypassPermissions
# HEARTBEAT_PERMISSION_MODE=acceptEdits

# --- Optional: OpenCode backend (only when HEARTBEAT_BACKEND=opencode) ---
# OPENCODE_BASE_URL=http://localhost:4096
# OPENCODE_USERNAME=opencode
# OPENCODE_PASSWORD=
# OPENCODE_MESSAGE_TIMEOUT=3600

# --- Optional: semantic_search (rules/skills/semantic_search.md) ---
# OPENAI_API_KEY=

# --- Optional: Anthropic Messages API (only if you add an API-based backend) ---
# ANTHROPIC_API_KEY=

# --- tavily-skill (adhoc_jobs/tavily-skill; search/extract CLI) ---
# TAVILY_API_KEY=
# ONEPASSWORD_TAVILY_REFERENCE=op://your-vault/your-item/your-field
