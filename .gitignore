# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Secrets & local config
.env

# Caches & scratch
.knowledge_cache/
tmp/
*.log
.DS_Store

# adhoc_jobs/ is a workbench, not content. Everything dropped in it is either a nested
# project with its own git (ai_job_copilot — private, managed by adhoc_jobs/ai_job_copilot/.git)
# or a vendored public skill repo (re-clone per docs/SKILL_ECOSYSTEM.md, don't copy it in here).
# So ignore the CONTENTS wholesale rather than naming each one — a per-project line has to be
# added by hand every time and is silently lost whenever an upstream sync rewrites this file.
# The directory itself stays in the repo via the un-ignored .gitkeep below.
/adhoc_jobs/*
!/adhoc_jobs/.gitkeep
/contexts/survey_sessions/*
!/contexts/survey_sessions/
.env.*
!.env.example
.pytest_cache/
